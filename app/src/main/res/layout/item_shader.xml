<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Widget.OrbitX.CardView.Item"
    tools:context=".ui.browser.ShaderBrowserFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Shader Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/image_view_shader_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_shaders"
                app:tint="@color/orbitx_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_view_shader_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BSL Shaders"
                    android:textColor="@color/orbitx_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    style="@style/Widget.OrbitX.TextView.Primary" />

                <TextView
                    android:id="@+id/text_view_shader_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="High-quality shader pack with realistic lighting"
                    android:textColor="@color/orbitx_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    style="@style/Widget.OrbitX.TextView.Secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Shader Details Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_view_shader_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Author: BSL Team"
                android:textColor="@color/orbitx_text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/orbitx_divider" />

            <TextView
                android:id="@+id/text_view_shader_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version: 8.1.0"
                android:textColor="@color/orbitx_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Shader Details Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_view_shader_downloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1M downloads"
                android:textColor="@color/orbitx_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/orbitx_divider" />

            <TextView
                android:id="@+id/text_view_shader_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size: 25 MB"
                android:textColor="@color/orbitx_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Shader Details Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_view_shader_compatibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compatible: 1.20.4, 1.20.3"
                android:textColor="@color/orbitx_text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/orbitx_divider" />

            <TextView
                android:id="@+id/text_view_shader_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rating: 4.9"
                android:textColor="@color/orbitx_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/orbitx_divider" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/button_install"
                style="@style/Widget.OrbitX.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/install" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
