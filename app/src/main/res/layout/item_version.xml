<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Widget.OrbitX.CardView.Item"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Version Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/image_view_version_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_minecraft"
                android:contentDescription="@string/minecraft_java"
                app:tint="@color/orbitx_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_view_version_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.20.4"
                    android:textColor="@color/orbitx_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    style="@style/Widget.OrbitX.TextView.Primary" />

                <TextView
                    android:id="@+id/text_view_version_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Release"
                    android:textColor="@color/orbitx_text_secondary"
                    android:textSize="12sp"
                    style="@style/Widget.OrbitX.TextView.Secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Version Date -->
        <TextView
            android:id="@+id/text_view_version_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2024-01-01"
            android:textColor="@color/orbitx_text_secondary"
            android:textSize="12sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/orbitx_divider" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/button_uninstall"
                style="@style/Widget.OrbitX.Button.Remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove"
                android:visibility="gone" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/button_install"
                style="@style/Widget.OrbitX.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/install" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
